# Substitua print.exemplo.com e os caminhos dos certificados antes de habilitar.
server {
    listen 80;
    listen [::]:80;
    server_name print.exemplo.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name print.exemplo.com;

    ssl_certificate /etc/letsencrypt/live/print.exemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/print.exemplo.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 7000m;
    client_body_timeout 1800s;
    client_body_buffer_size 512k;
    proxy_connect_timeout 60s;
    proxy_send_timeout 1800s;
    proxy_read_timeout 1800s;
    proxy_request_buffering off;

    location ~ /(?:\.env|\.git|config|database|includes|services|docker|scripts|tests|uploads)(?:/|$) {
        deny all;
        return 404;
    }

    location ~* \.(?:sql|log|ini|ya?ml|bak|dist|sh)$ {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ~* \.(?:css|js|svg|png|webmanifest)$ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
