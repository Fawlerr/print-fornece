server {
    listen 80;
    server_name app.example.com;
    client_max_body_size 30m;

    location /static/ {
        alias /srv/print-fornece/django_app/staticfiles/;
        access_log off;
        expires 7d;
    }

    # Uploaded files must only be served through the authorization-aware Django
    # download endpoint. Do not expose /media/order_attachments/ directly.
    location /media/ {
        internal;
    }

    location / {
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://unix:/run/print-fornece/gunicorn.sock;
    }
}

