# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
MAX_UPLOAD_BYTES=6442450944
DATA_UPLOAD_MAX_MEMORY_SIZE=6442450944


# MySQL/MariaDB (new Django database; never point migrations at the PHP database)
MYSQL_DATABASE=print_fornece_django
MYSQL_USER=print_fornece
MYSQL_PASSWORD=replace-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional email delivery for password resets
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com

# Legacy import only: source database and the original PHP uploads directory.
LEGACY_MYSQL_DATABASE=
LEGACY_MYSQL_USER=
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_UPLOAD_ROOT=/srv/legacy-print-fornece/uploads/pedidos

