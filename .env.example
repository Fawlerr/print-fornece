# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
MAX_UPLOAD_BYTES=6442450944
DATA_UPLOAD_MAX_MEMORY_SIZE=6442450944


# MySQL/MariaDB (new Django database; never point migrations at the PHP database)
MYSQL_DATABASE=print_fornece_django
MYSQL_USER=print_fornece
MYSQL_PASSWORD=replace-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional email delivery for password resets
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com

# Backups & Cloud Sync
BACKUP_RETENTION_DAYS=30
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_CREDENTIALS_PATH=

# Stone / Pagar.me V5 Integration
# Defina STONE_ENVIRONMENT=sandbox para homologação ou STONE_ENVIRONMENT=production para produção
STONE_ENVIRONMENT=sandbox
# Credenciais Sandbox
STONE_SANDBOX_ACCOUNT_ID=acc_xxxxxxxxxxxxxxxx
STONE_SANDBOX_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
STONE_SANDBOX_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STONE_SANDBOX_API_URL=https://api.pagar.me/core/v5
STONE_SANDBOX_WEBHOOK_SECRET=
# Credenciais Produção
STONE_PROD_ACCOUNT_ID=acc_xxxxxxxxxxxxxxxx
STONE_PROD_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxx
STONE_PROD_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STONE_PROD_API_URL=https://api.pagar.me/core/v5
STONE_PROD_WEBHOOK_SECRET=
# Configurações Adicionais da Stone
STONE_API_BASE_URL=https://api.pagar.me/core/v5
STONE_ACCOUNT_TYPE=gateway
STONE_TIMEOUT_SECONDS=15
STONE_PIX_EXPIRES_IN=86400
STONE_IDEMPOTENCY_TTL_SECONDS=300
STONE_PIX_DEBUG=True

# Link de pagamento (Pagar.me /paymentlinks). Vazio = sdx-api em sandbox e api.pagar.me em produção.
STONE_PAYMENT_LINK_API_URL=

# Chat de WhatsApp — provedor padrão: Umbler Talk (umbler) ou Evolution API (evolution)
WHATSAPP_PROVEDOR=umbler
# Endereço público do Print Fornece (monta a URL do webhook mostrada em Chat > Números conectados)
WHATSAPP_WEBHOOK_BASE_URL=https://print.exemplo.com.br

# Umbler Talk — token em https://account.umbler.com/profile; organização em GET /v1/members/me/
UMBLER_API_URL=https://app-utalk.umbler.com/api
UMBLER_API_TOKEN=troque-pelo-token-da-umbler
UMBLER_ORGANIZATION_ID=troque-pelo-id-da-organizacao
UMBLER_TIMEOUT_SECONDS=20
# Segredo longo e aleatório que vai na URL do webhook cadastrada no painel da Umbler
UMBLER_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio

# Evolution API (alternativa) — chave só no servidor, nunca no navegador
EVOLUTION_API_URL=https://evolution.exemplo.com.br
EVOLUTION_API_KEY=troque-pela-apikey-da-evolution
# 2 para Evolution v2.x (padrão) ou 1 para v1.8.x
EVOLUTION_API_VERSION=2
EVOLUTION_TIMEOUT_SECONDS=15
# Endereço público do Print Fornece que a Evolution consegue acessar
EVOLUTION_WEBHOOK_BASE_URL=https://print.exemplo.com.br
# Segredo longo e aleatório (ex.: python -c "import secrets; print(secrets.token_urlsafe(32))")
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio
# Mídias do chat (fora de /media/, só com login)
WHATSAPP_MEDIA_ROOT=/app/private_media
WHATSAPP_MAX_UPLOAD_MB=16
WHATSAPP_REVOGAR_ATE_HORAS=48
