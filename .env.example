# Copie para .env e troque todos os valores de exemplo antes de iniciar.
APP_ENV=production
APP_URL=https://print.exemplo.com
APP_DEBUG=false
APP_PORT=8080
TIMEZONE=America/Fortaleza
SESSION_SECURE=true

# Mantenha o banco apenas na rede Docker; DB_HOST=db é o padrão do Compose.
DB_HOST=db
DB_PORT=3306
DB_NAME=print_fornece
DB_USER=print_fornece
DB_PASSWORD=troque-por-uma-senha-longa-e-unica
DB_ROOT_PASSWORD=troque-por-outra-senha-longa-e-unica

# 25 MiB por arquivo. Deve ser compatível com docker/php/uploads.ini e Nginx.
MAX_UPLOAD_BYTES=26214400
